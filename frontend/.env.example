# SCOUT frontend environment (Vite). Copy to .env for local dev, or set these
# in the Vercel project's Environment Variables for cloud deploys.
#
# VITE_API_URL = your backend origin. Rules:
#   - bare origin only — NO path, NO trailing slash (the app appends /v1/... itself)
#   - local dev:  http://localhost:8000
#   - cloud:      https://<your-render-service>.onrender.com
# Vite bakes env vars in at BUILD time — after changing VITE_API_URL on Vercel,
# redeploy the frontend for it to take effect.
VITE_API_URL=http://localhost:8000
