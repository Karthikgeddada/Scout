# -----------------------------------------------------------------------------
# SCOUT environment example. PLACEHOLDERS ONLY. Never commit real secrets.
# Copy to .env and fill in real values for your environment.
# -----------------------------------------------------------------------------

# --- Runtime ---
SCOUT_ENVIRONMENT=development                     # development | staging | production
SCOUT_API_PREFIX=/v1
SCOUT_CORS_ALLOW_ORIGINS=http://localhost:5173    # comma-separated; prod: https://<your-app>.vercel.app

# --- Supabase ---
SCOUT_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SCOUT_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SCOUT_SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>   # backend only - NEVER expose to clients
SCOUT_SUPABASE_JWKS_URL=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
SCOUT_SUPABASE_JWT_AUDIENCE=authenticated
SCOUT_STORAGE_BUCKET=documents                    # private bucket

# --- Database ---
# Single-container deploys (Render all-in-one) need NOTHING here: start.sh
# boots an in-container PostgreSQL 15 + pgvector with scout/scout and points
# SCOUT_DATABASE_URL at localhost automatically.
# Set an external URL (e.g. Supabase Postgres) only if you want one:
SCOUT_DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# --- RabbitMQ ---
SCOUT_RABBITMQ_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@<RABBITMQ_HOST>:5672/%2Fscout

# --- Google Gemini (server-side only) ---
SCOUT_GEMINI_API_KEY=<GEMINI_API_KEY>
SCOUT_GEMINI_MODEL=<GEMINI_MODEL_NAME>            # e.g. gemini-2.0-flash
SCOUT_GEMINI_MAX_OUTPUT_TOKENS=8192

# --- Local embedding model ---
SCOUT_EMBEDDING_MODEL_ID=<HF_MODEL_ID>            # e.g. Qwen/Qwen3-Embedding-0.6B
SCOUT_EMBEDDING_DIM=1024
SCOUT_EMBEDDING_DEVICE=auto                        # auto | cpu | cuda
SCOUT_EMBEDDING_BATCH_SIZE=32

# --- Local reranker ---
SCOUT_RERANKER_MODEL_ID=<HF_MODEL_ID>             # e.g. Qwen/Qwen3-Reranker-0.6B
SCOUT_RERANKER_DEVICE=auto
SCOUT_RERANKER_ENABLED=true

# --- Retrieval tuning ---
SCOUT_RRF_K=60
SCOUT_LEXICAL_CANDIDATES=50
SCOUT_DENSE_CANDIDATES=50
SCOUT_RERANK_CANDIDATES=40
SCOUT_FINAL_CONTEXT_CHUNKS=12
SCOUT_CONTEXT_TOKEN_BUDGET=12000

# --- Chunking ---
SCOUT_CHUNK_TARGET_TOKENS=550
SCOUT_CHUNK_OVERLAP_TOKENS=80
SCOUT_CHUNK_MIN_TOKENS=80

# --- Uploads ---
SCOUT_UPLOAD_MAX_BYTES=104857600                  # 100 MiB

# --- Rate limiting ---
SCOUT_RATE_LIMIT_REQUESTS=120
SCOUT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Jobs ---
SCOUT_JOB_MAX_RETRIES=3

# --- Frontend (Vite) - NOT secret. Auth redirects to the Supabase-hosted
# login page, so the SPA needs no Supabase keys; in dev the app accepts a
# pasted access token instead. ---
VITE_API_URL=http://localhost:8000
